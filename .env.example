# Copy this file to .env before starting the stack.
# Replace this value with a long, unique password before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Local HTTP setting. The production Compose overlay turns this on for HTTPS.
COOKIE_SECURE=false

# Host port serving the frontend.
FRONTEND_PORT=8080

# Set a DNS name whose A record points to the VM before production deployment.
PUBLIC_IP=203.0.113.10
